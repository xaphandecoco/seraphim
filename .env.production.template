# ============================================================================
# Project Seraphim — PRODUCTION environment template
# ============================================================================
# Derived from .env.template, but hardened for a real deployment.
#
#   1. Copy this file to ".env.production" (or ".env" next to the compose file).
#   2. Replace every "__GENERATE_ME__" with a strong, unique secret.
#      The easiest way is to run:  ./scripts/generate-secrets.sh
#      which fills the secrets in for you.
#   3. NEVER commit the filled-in file. Only this *.template is committed.
#
# Variable names below MUST match exactly what the app/compose reads
# (cross-checked against .env.template, backend/app/config.py and the
# docker-compose*.yml files). Do not rename them.
# ============================================================================

# ---------------------------------------------------------------------------
# Environment
# ---------------------------------------------------------------------------
# Must be "production" in prod. Enables secure cookies, disables /docs, and
# makes the backend refuse to start with a weak/empty JWT secret.
ENVIRONMENT=production

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Postgres password for the "seraphim" role. Used both by the postgres
# container and to build DATABASE_URL in the compose files. Avoid characters
# that need URL-encoding (@ : / # ?) — generate-secrets.sh handles this.
DB_PASSWORD=__GENERATE_ME__

# ---------------------------------------------------------------------------
# CompreFace (external face-recognition instance — not bundled in compose)
# ---------------------------------------------------------------------------
# These can also be set later through the in-app Setup wizard / Settings UI
# (they live in dynamic_settings). Provide them here only if you prefer
# env-based configuration.
COMPREFACE_API_KEY=__GENERATE_ME__
COMPREFACE_URL=http://your-compreface-host:8080

# ---------------------------------------------------------------------------
# CiviCRM
# ---------------------------------------------------------------------------
CIVICRM_URL=https://lightnc.org/civicrm
CIVICRM_API_KEY=__GENERATE_ME__
CIVICRM_SITE_KEY=__GENERATE_ME__

# ---------------------------------------------------------------------------
# Google OAuth (optional — only if Google sign-in is enabled in Settings)
# ---------------------------------------------------------------------------
# The authorized redirect URI in the Google console must be your HTTPS domain,
# e.g. https://seraphim.example.org/auth/google/callback
GOOGLE_CLIENT_ID=__GENERATE_ME__
GOOGLE_CLIENT_SECRET=__GENERATE_ME__

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
# JWT signing secret. MUST be >= 32 chars; the app fails startup otherwise.
# generate-secrets.sh produces 64 hex chars (openssl rand -hex 32).
JWT_SECRET=__GENERATE_ME__

# ---------------------------------------------------------------------------
# Access Control
# ---------------------------------------------------------------------------
# Comma-separated list of admin emails (bootstrapped as admins on first login).
ADMIN_EMAILS=admin1@lightnc.org,admin2@lightnc.org

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
# In-container path for face images / snapshots. Backed by a host bind-mount
# in the compose files; keep this as the in-container path.
STORAGE_PATH=/app/storage

# ---------------------------------------------------------------------------
# Queue Worker
# ---------------------------------------------------------------------------
POLL_INTERVAL=1
WORKER_CONCURRENCY=3

# ---------------------------------------------------------------------------
# Logging (DEBUG | INFO | WARNING | ERROR)
# ---------------------------------------------------------------------------
# Keep at INFO (or WARNING) in production. DEBUG is noisy and can leak detail.
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Gitea (self-hosted Git on Unraid — only used by docker-compose.unraid.yml)
# ---------------------------------------------------------------------------
GITEA_DB_PASSWORD=__GENERATE_ME__

# ---------------------------------------------------------------------------
# Webhook secret for the auto-update pipeline (scripts/webhook_listener.py)
# ---------------------------------------------------------------------------
# MUST be >= 32 chars; the listener refuses to start otherwise.
WEBHOOK_SECRET=__GENERATE_ME__

# ---------------------------------------------------------------------------
# Reverse proxy / TLS (only used by docker-compose.caddy.yml + Caddyfile)
# ---------------------------------------------------------------------------
# Your real public hostname. Caddy uses this to auto-provision a Let's Encrypt
# certificate. Must resolve (DNS A/AAAA record) to this host, with ports
# 80 + 443 reachable. Leave commented if you terminate TLS elsewhere
# (e.g. Nginx Proxy Manager) instead of Caddy.
# DOMAIN=seraphim.example.org

# ============================================================================
# HTTPS / secure-cookie notes
# ============================================================================
# - With ENVIRONMENT=production the refresh cookie is issued Secure + HttpOnly,
#   so the app MUST be served over HTTPS end-to-end. Terminate TLS at Caddy
#   (docker-compose.caddy.yml) or another HTTPS proxy in front of the
#   frontend — plain http:// will break login (the Secure cookie is dropped).
# - The backend honors X-Forwarded-Proto from the proxy; do not strip it.
# - Never expose the backend (3001) or Postgres/Redis ports publicly — only
#   the proxy's 443 should be reachable from the internet.
# ============================================================================

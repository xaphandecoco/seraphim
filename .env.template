# Database
DB_PASSWORD=changeme

# Compreface (external instance — not bundled in Docker Compose)
COMPREFACE_API_KEY=your-compreface-key
COMPREFACE_URL=http://your-compreface-host:8080

# CiviCRM
CIVICRM_URL=https://lightnc.org/civicrm
CIVICRM_API_KEY=your-civicrm-api-key
CIVICRM_SITE_KEY=your-civicrm-site-key

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Security
JWT_SECRET=generate-a-256-bit-secret

# Access Control
ADMIN_EMAILS=admin1@lightnc.org,admin2@lightnc.org

# Storage
STORAGE_PATH=/app/storage

# Queue Worker
POLL_INTERVAL=1
WORKER_CONCURRENCY=3

# Logging (DEBUG | INFO | WARNING | ERROR)
LOG_LEVEL=INFO

# Gitea (self-hosted Git on Unraid)
GITEA_DB_PASSWORD=changeme

# Webhook secret for auto-update pipeline
WEBHOOK_SECRET=generate-a-random-secret-for-webhooks
